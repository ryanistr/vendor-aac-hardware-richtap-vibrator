package vendor.oplus.hardware.lmvibrator@1.0;

interface ILinearMotorVibrator {
    linearmotorVibratorOn(int32_t waveformId, int16_t amplitude, bool isRtpMode);
    linearmotorVibratorOff();
    write_gun_type(int32_t gunType);
    getStatus() generates (int32_t status);
    setVmax(int32_t vmax);
    write_bullet_num(int32_t bulletNum);
    write_gun_mode(int32_t gunMode);
    write_haptic_audio(string data);
    setVibratorTouchStyle(int32_t touchStyle);
    getVibratorTouchStyle() generates (int32_t touchStyle);
};
